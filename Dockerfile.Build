# Stage 2: Create a clean Ubuntu-based image for copying built files
FROM ubuntu:latest

# Install necessary packages
RUN apt-get update && apt-get install -y nodejs npm

# Copy your project files into the container
WORKDIR /payroll-contract

# Clear the contents of the working directory
RUN rm -rf ./*

# Copy package.json and package-lock.json
COPY package*.json /payroll-contract/

# Install dependencies
RUN npm install

COPY src /payroll-contract/src/

# Copy the HotPocket config override and environment file (MANDATORY)
COPY hp.cfg.override /payroll-contract/
COPY .env /payroll-contract/

# Build your project
RUN npm run buildLinux
